# 正式部署建议复制为 .env；密钥留空时系统首次启动会生成高强度随机密钥并写入独立安全库
# 若做多机/灾备一致密钥，请用 openssl rand -hex 32 生成后填写
SESSION_SECRET=
QDT_BACKUP_PEPPER=

# 留空时可在后台「安全中心」轮换打印代理 Token
# 若通过环境变量固定，安全中心会提示修改 .env，避免与线上代理配置不一致
QDT_AGENT_TOKEN=

PORT=8282
TZ=Asia/Shanghai
NODE_ENV=production
WEB_CONCURRENCY=4
DATA_DIR=/app/data
QDT_DB_DIR=/app/data
QDT_SECURITY_DB_DIR=/app/data/security
QDT_BACKUP_DIR=/app/backups
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately
# HTTP 默认 0；启用 HTTPS 后改成 1
QDT_SECURE_COOKIE=0
# Docker 非 root 运行用户；挂载目录需同 UID/GID 可写
QDT_UID=1000
QDT_GID=1000
